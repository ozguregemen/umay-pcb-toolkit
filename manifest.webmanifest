{
  "name": "Umay PCB Toolkit",
  "short_name": "Umay PCB",
  "description": "Open-source PCB and electronics calculators with lessons, based on IPC rules.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5f2",
